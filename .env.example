# Copy to .env and fill in your own values. Never commit .env.
# setup.sh creates .env from this file (only if .env does not exist) with mode 600.

APP_ENV=development
# Keep the API bound to localhost. Changing this exposes your media and credentials.
APP_HOST=127.0.0.1
APP_PORT=8000

DATABASE_URL=sqlite:///./data/app.db

# AI provider (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Meta (Instagram / Facebook) — https://developers.facebook.com/
META_APP_ID=
META_APP_SECRET=

# TikTok — https://developers.tiktok.com/
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Google (YouTube Data API) — https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional S3-compatible storage (needed later for Instagram publishing, which
# requires publicly reachable media URLs)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=

# Default parent folder for new projects. Put this outside the repository for
# real work, e.g. ~/Content
MEDIA_ROOT=./projects

# Frontend → backend URL (used by the Next.js dashboard)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
