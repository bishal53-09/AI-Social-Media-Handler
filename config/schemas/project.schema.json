{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-social-media-handler.local/schemas/project.schema.json",
  "title": "Project",
  "description": "Portable project metadata stored at <project>/project.json.",
  "type": "object",
  "required": ["schema_version", "id", "name", "created_at", "updated_at", "settings"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "description": { "type": ["string", "null"], "maxLength": 5000 },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "timezone": { "type": "string" },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default_camera": { "type": ["string", "null"] },
        "color_profile": { "type": ["string", "null"] },
        "platforms": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    }
  }
}
