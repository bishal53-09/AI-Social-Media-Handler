{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-social-media-handler.local/schemas/day.schema.json",
  "title": "Day",
  "description": "All clips captured on one calendar day: <project>/data/days/YYYY-MM-DD.json.",
  "type": "object",
  "required": ["date", "project_id", "clips"],
  "additionalProperties": false,
  "properties": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "project_id": { "type": "string" },
    "notes": { "type": ["string", "null"] },
    "clips": { "type": "array", "items": { "$ref": "clip.schema.json" } }
  }
}
